rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: public fields readable by all for profiles and search
    // Only the account owner can modify their profile details, or follow metrics can be updated
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount'])
      );
      allow delete: if false;

      // User notifications sub-collection
      // 1. Only recipient user can read, update (mark read), or delete their own notifications
      // 2. Authenticated users can send notifications to others (not self) with matching senderUid
      match /notifications/{notificationId} {
        allow read, update, delete: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.recipientUid == userId &&
          request.resource.data.recipientUid != request.auth.uid;
      }
    }

    // Follows collection
    // 1. Readable publicly so follow status and counts can be verified
    // 2. Only authenticated users can follow; followerUid must match auth.uid
    // 3. Prevent self-following (followerUid != followingUid)
    // 4. Deterministic follow ID prevents duplicates (id == followerUid_followingUid)
    // 5. Only the follower can unfollow (delete their own follow record)
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.followerUid == request.auth.uid &&
        request.resource.data.followingUid != request.auth.uid &&
        request.resource.data.id == request.auth.uid + '_' + request.resource.data.followingUid;
      allow delete: if isAuthenticated() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    // Posts collection
    // 1. Anyone can read posts in the public Home Feed
    // 2. Only authenticated users can create posts, and authorUid must match their real auth UID
    // 3. Only the original author can edit post text/image, or other users can update like/comment metrics
    // 4. Only the original author can delete their post
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likeCount', 'likesCount', 'likedUserIds', 'likedBy', 'commentsCount', 'comments'
        ])
      );
      allow delete: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        resource.data.authorId == request.auth.uid
      );

      // Comments sub-collection: posts/{postId}/comments/{commentId}
      // Publicly readable so everyone can read comments on public posts
      // Creatable by any authenticated user; authorUid must match auth.uid
      // Deletable by the comment author or the post owner
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isAuthenticated() && (
          resource.data.authorUid == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
        );
        allow update: if false;
      }
    }

    // Direct 1-on-1 Chats Collection
    // 1. Only participants can read or update conversation metadata
    // 2. Authenticated user can create chat if they are in participants
    // 3. Messages sub-collection readable and creatable only by conversation participants
    match /chats/{chatId} {
      allow read, update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isAuthenticated() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // Hunar Skill Exchange Posts Collection
    // 1. Readable publicly so all users can discover skills to learn
    // 2. Only authenticated users can create hunar posts (authorUid == request.auth.uid)
    // 3. Author can update/delete their post, or other users can increment learnersCount
    match /hunar_posts/{hunarId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.authorUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['learnersCount', 'learnerUids'])
      );
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
